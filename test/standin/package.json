{
  "name": "claude-code",
  "publisher": "anthropic",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onWebviewPanel:claudeVSCodePanel",
    "workspaceContains:open-chat.flag"
  ],
  "contributes": {
    "commands": [
      {
        "command": "standin.openChat",
        "title": "Stand-in: open a chat page built like Claude Code's"
      },
      {
        "command": "standin.render",
        "title": "Stand-in: render code blocks in the chat page"
      },
      {
        "command": "standin.chatReceived",
        "title": "Stand-in: list the messages the chat page posted"
      },
      {
        "command": "standin.closeChat",
        "title": "Stand-in: close the chat page"
      },
      {
        "command": "standin.open",
        "title": "Stand-in: open the chat webview"
      },
      {
        "command": "standin.received",
        "title": "Stand-in: list the messages the page received"
      },
      {
        "command": "standin.close",
        "title": "Stand-in: close the chat webview"
      },
      {
        "command": "standin.openLink",
        "title": "Stand-in: open a chat link as Claude Code does"
      },
      {
        "command": "standin.showDocument",
        "title": "Stand-in: showTextDocument with a TextDocument"
      },
      {
        "command": "standin.activeTab",
        "title": "Stand-in: describe the active tab"
      },
      {
        "command": "standin.groupCount",
        "title": "Stand-in: count the editor groups"
      },
      {
        "command": "standin.setting",
        "title": "Stand-in: read a bridge setting"
      },
      {
        "command": "standin.selections",
        "title": "Stand-in: list the selections its listener received"
      },
      {
        "command": "standin.clearsChip",
        "title": "Stand-in: clear the chip when no text editor is in front, as Claude Code does"
      }
    ]
  }
}
