  "license": "MIT",
  "keywords": ["vscode", "ide", "browser", "mcp"],
  "mcpServers": {
    "vscode-tools": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/launcher.mjs"]
    }
  }
}
