  "description": "Gives Claude Code the tools and the screen of the VS Code window it works in. Needs the VS Code Bridge for Claude Code extension.",
  "author": {
    "name": "Klaster_1",
    "url": "https://github.com/Klaster1"
  },
  "homepage": "https://github.com/Klaster1/vscode-bridge-for-claude-code",
